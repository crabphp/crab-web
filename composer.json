{
    "name": "crabphp/crab-web",
    "description": "A starting point for a web application on the Crab framework: pages, components, sessions and models",
    "type": "project",
    "require": {
        "php": "^8.4",
        "crabphp/framework": "^0.7.3",
        "crabphp/arc": "^0.3",
        "crabphp/tide": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php cua key:generate",
            "@php cua migrate"
        ]
    },
    "prefer-stable": true
}
